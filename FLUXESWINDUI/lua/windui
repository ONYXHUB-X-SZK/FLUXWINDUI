		if isAnimating then return end
		isAnimating = true
		CloseAllPopups()

		Tween(BlurEffect, 0.35, { Size = 0 })
		Tween(MainFrame, 0.25, { BackgroundTransparency = 1 })

		local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
