			MainFrame.Visible = false
			WindowScale.Scale = baseScale

			FloatBtn.Visible = true
			FloatScale.Scale = 0
			local ti2 = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			TweenService:Create(FloatScale, ti2, { Scale = 1 }):Play()

			isAnimating = false
		end)
		winOpen = false
	end

