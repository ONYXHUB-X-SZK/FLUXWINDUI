-- ============================================
-- SZK WIND UI - EXECUTOR
-- ============================================
local szk = loadstring(game:HttpGet("https://raw.githubusercontent.com/ONYXHUB-X-SZK/FLUXWINDUI/refs/heads/main/FLUXESWINDUI/lua/windui"))()

-- ============================================
-- CREAR VENTANA PRINCIPAL
-- ============================================
local Window = szk:CreateWindow({
    Title = "SZK Wind UI",
    Description = "Made by SZK",
    Theme = "RUBI",              -- Tema rubí por defecto
    ThemeSelector = true,         -- Selector de temas
    BackgroundSelector = true,    -- Selector de fondos (11 opciones)
    OpenIconSelector = true,      -- Selector de icono del botón flotante
    ToggleKey = Enum.KeyCode.RightShift,
    Size = Vector2.new(720, 480),
    OpenButtonText = "SZK",
    OpenButtonSize = 48,
    OpenButtonRadius = 12,
})

-- ============================================
-- TAB HOME
-- ============================================
local Home = Window:CreateTab({
    Name = "Home",
    Icon = "home",                -- Puedes usar cualquier icono del set SZK
})

-- ============================================
-- SECCIÓN DE BIENVENIDA
-- ============================================
local Welcome = Home:CreateSection({
    Name = "Bienvenido",
})

Welcome:CreateHero({
    Title = "SZK Wind UI",
    Content = "Interfaz moderna con temas personalizables, fondos dinámicos y un sistema de iconos completo. Usa los botones del header para cambiar el tema, fondo o icono del botón flotante.",
    Image = "121729739592124",
    ImageWidth = 140,
    Height = 180,
})

Welcome:CreateParagraph("Presiona RightShift para mostrar/ocultar la interfaz. Puedes arrastrar la ventana desde el header y redimensionarla desde la esquina inferior derecha.")

Welcome:CreateDivider()

-- ============================================
-- SECCIÓN DE UTILIDADES
-- ============================================
local Utils = Home:CreateSection({
    Name = "Utilidades",
})

Utils:CreateButton({
    Name = "Notificación de prueba",
    Description = "Muestra una notificación tipo Success",
    Icon = "check",
    Callback = function()
        szk:Success("SZK Wind UI", "¡Todo funciona correctamente!")
    end,
})

Utils:CreateButton({
    Name = "Notificación de error",
    Description = "Muestra una notificación tipo Error",
    Icon = "x",
    Callback = function()
        szk:Error("Error", "Esto es una notificación de error")
    end,
})

Utils:CreateButton({
    Name = "Notificación de advertencia",
    Description = "Muestra una notificación tipo Warning",
    Icon = "alert-triangle",
    Callback = function()
        szk:Warn("Advertencia", "Esto es una notificación de advertencia")
    end,
})

Utils:CreateButton({
    Name = "Notificación de info",
    Description = "Muestra una notificación tipo Info",
    Icon = "info",
    Callback = function()
        szk:Info("Información", "Esto es una notificación informativa")
    end,
})

Utils:CreateDivider()

-- ============================================
-- SECCIÓN DE CONFIGURACIÓN RÁPIDA
-- ============================================
local QuickConfig = Home:CreateSection({
    Name = "Configuración Rápida",
})

QuickConfig:CreateDropdown({
    Name = "Cambiar Tema",
    Options = {"RUBI", "Sovereign"},
    Default = "RUBI",
    Callback = function(value)
        Window:SetTheme(value)
        szk:Info("Tema aplicado", "Ahora usas: " .. tostring(value))
    end,
})

QuickConfig:CreateDropdown({
    Name = "Cambiar Fondo",
    Options = {
        "Fondo 1","Fondo 2","Fondo 3","Fondo 4","Fondo 5","Fondo 6",
        "Fondo 7","Fondo 8","Fondo 9","Fondo 10","Fondo 11"
    },
    Default = "Fondo 1",
    Callback = function(value)
        Window:SetBackground(value)
        szk:Info("Fondo aplicado", "Ahora usas: " .. tostring(value))
    end,
})

QuickConfig:CreateDropdown({
    Name = "Cambiar Icono del Botón",
    Options = {"Icono 1", "Icono 2", "Icono 3", "Icono 4"},
    Default = "Icono 1",
    Callback = function(value)
        Window:SetOpenButtonIcon(value)
        szk:Info("Icono aplicado", "Ahora usas: " .. tostring(value))
    end,
})

QuickConfig:CreateSlider({
    Name = "Opacidad del panel",
    Min = 0,
    Max = 100,
    Default = 92,
    Callback = function(value)
        -- Ajusta la transparencia del fondo principal
        if Window.SetBackgroundImage then
            -- No aplicamos porque ya está con fondo, pero lo dejamos como ejemplo
        end
    end,
})

QuickConfig:CreateDivider()

-- ============================================
-- SECCIÓN DE FLAGS / CONFIGURACIÓN
-- ============================================
local Flags = Home:CreateSection({
    Name = "Opciones del Script",
})

Flags:CreateToggle({
    Name = "Modo Rápido",
    Description = "Activa funciones rápidas del script",
    Default = false,
    Flag = "FastMode",
    Callback = function(state)
        szk:Info("Modo Rápido", state and "Activado" or "Desactivado")
    end,
})

Flags:CreateToggle({
    Name = "Auto Ejecutar",
    Description = "Ejecuta acciones automáticamente",
    Default = false,
    Flag = "AutoRun",
    Callback = function(state)
        szk:Info("Auto Ejecutar", state and "Activado" or "Desactivado")
    end,
})

Flags:CreateInput({
    Name = "Nombre de usuario",
    Placeholder = "Escribe tu nombre...",
    Default = "",
    Callback = function(text, enter)
        if enter then
            szk:Success("Guardado", "Nombre: " .. text)
        end
    end,
})

Flags:CreateKeybind({
    Name = "Tecla rápida",
    Default = Enum.KeyCode.F,
    Callback = function(key)
        szk:Info("Keybind", "Tecla asignada: " .. key.Name)
    end,
})

Flags:CreateDivider()

-- ============================================
-- SECCIÓN DE PROGRESO
-- ============================================
local ProgressSec = Home:CreateSection({
    Name = "Estado",
})

local progressBar = ProgressSec:CreateProgressBar({
    Name = "Cargando módulos",
    Min = 0,
    Max = 100,
    Default = 0,
    ShowPercent = true,
})

-- Simular carga
task.spawn(function()
    for i = 0, 100, 5 do
        progressBar:Set(i, true)
        task.wait(0.05)
    end
    szk:Success("Completado", "Todos los módulos cargados")
end)

ProgressSec:CreateDivider()

-- ============================================
-- SECCIÓN DE CRÉDITOS
-- ============================================
local Credits = Home:CreateSection({
    Name = "Créditos",
})

Credits:CreateLabel("SZK Wind UI v1.0")
Credits:CreateLabel("Desarrollado por SZK Team")
Credits:CreateParagraph("Interfaz basada en Fluxo Wind UI con temas personalizables, selector de fondos e iconos dinámicos. Todos los iconos son cargados desde el repositorio oficial de SZK.")

Credits:CreateBanner({
    Image = "127475690425531",
    Height = 140,
    Title = "SZK",
    Caption = "Wind UI • 2025",
})

-- ============================================
-- NOTIFICACIÓN INICIAL
-- ============================================
task.delay(0.5, function()
    szk:Success("SZK Wind UI", "Cargado correctamente. Usa RightShift para ocultar.")
end)

-- ============================================
-- RETURN (opcional, para acceso externo)
-- ============================================
return szk
