			Overlay,
			TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ BackgroundTransparency = overlayTrans }
		)
		contentFade:Play()

		anim.Completed:Connect(function() isAnimating = false end)
		winOpen = true
	end

