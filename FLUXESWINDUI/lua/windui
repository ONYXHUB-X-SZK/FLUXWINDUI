local SZK = loadstring(game:HttpGet("https://raw.githubusercontent.com/ONYXHUB-X-SZK/SZKWINDUI/main/SZKWINDUI.lua"))()

-- Window (WindUI‑style config)
local win = SZK:CreateWindow({
    Title = "My SZK Hub",
    Description = "by ONYXHUB X SZK",
    Theme = "SZK",
    ToggleKey = Enum.KeyCode.RightShift,
    ThemeSelector = true,
    BackgroundSelector = true,
    OpenIconSelector = true,
    OpenButtonText = "Abrir SZK",
    OpenButtonSize = 48,
})

-- Tab
local main = win:CreateTab({ Title = "Main", Icon = "home" })

-- Section
local combat = main:CreateSection({ Name = "Combat", Icon = "sword" })

-- Toggle
combat:CreateToggle({
    Name = "Auto Attack",
    Desc = "Automatically attacks nearby enemies",
    Default = false,
    Flag = "AutoAttack",
    Callback = function(v)
        print("Auto Attack:", v)
    end,
})

-- Slider
combat:CreateSlider({
    Name = "Attack Speed",
    Min = 0.1,
    Max = 5,
    Default = 1,
    Callback = function(v)
        print("Speed:", v)
    end,
})

-- Button
combat:CreateButton({
    Name = "Execute Combo",
    Desc = "Runs the combo script",
    Icon = "zap",
    Callback = function()
        SZK:Success("Combo", "Executed successfully")
    end,
})

-- Dropdown
combat:CreateDropdown({
    Name = "Target Priority",
    Options = {"Closest", "Lowest HP", "Highest HP"},
    Default = "Closest",
    Callback = function(v)
        print("Target:", v)
    end,
})

-- Input
combat:CreateInput({
    Name = "Webhook",
    Placeholder = "https://discord.com/api/webhooks/...",
    Callback = function(text)
        print("Webhook:", text)
    end,
})

-- Keybind
combat:CreateKeybind({
    Name = "Panic Key",
    Default = Enum.KeyCode.P,
    Callback = function(key)
        print("Panic:", key.Name)
    end,
})

-- ColorPicker
combat:CreateColorPicker({
    Name = "ESP Color",
    Default = Color3.fromRGB(255, 0, 0),
    Callback = function(col)
        print("Color:", col)
    end,
})

-- Paragraph
combat:CreateParagraph("This is a paragraph of text that can wrap across multiple lines. Useful for credits, instructions, or descriptions.")

-- Divider
combat:CreateDivider()

-- ProgressBar
combat:CreateProgressBar({
    Name = "Loading",
    Min = 0,
    Max = 100,
    Default = 0,
})

-- Notification
SZK:Info("Loaded", "SZKWINDUI is ready!")
